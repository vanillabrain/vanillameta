{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip
	# Studio AI answers as NDJSON (application/x-ndjson) when asked: lines must reach the browser as they are
	# written. Caddy's default `encode` list does not include that type (it compresses text/* and a fixed
	# set of application/* types), and flush_interval -1 below sends each write through. Measure the
	# first-byte time through this proxy in the M2-5 run; if a Caddy upgrade ever compresses it, add a
	# response matcher here.

	# Caddy replaces X-Forwarded-* sent by untrusted clients, so the chain the API reads starts here.
	reverse_proxy web:80 {
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
