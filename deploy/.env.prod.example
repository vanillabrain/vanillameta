# Copy to .env.prod (never commit it) and fill every value. Generate secrets with: openssl rand -hex 32
# docker compose refuses to start while a required value is empty.

# --- Public address -------------------------------------------------------------------------
APP_DOMAIN=app.example.com        # DNS A record must already point at this VM; Caddy gets the certificate
ACME_EMAIL=ops@example.com        # Let's Encrypt contact

# --- Images (set by the deploy workflow; pin a tag, never "latest") -------------------------------
IMAGE_TAG=
# API_IMAGE=ghcr.io/vanillabrain/vanillameta-api
# WEB_IMAGE=ghcr.io/vanillabrain/vanillameta-web

# --- Database -------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# MYSQL_DATABASE=vanillameta
# MYSQL_USER=vanillameta

# --- Application secrets (each at least 32 characters, no "dev-only-" prefix) ---------------------
ACCESS_SECRET=
REFRESH_SECRET=
JWT_ACCESS_SECRET=
URL_ACCESS_SECRET=
CONFIG_SECRET_KEY=

# --- Data sources: uploads and the sample only. Do not list network engines without egress-guard.sh
# ALLOWED_SOURCE_TYPES=file,sample

# --- Signup: invite (default in prod) | closed | open. Invitations are made with access-cli (see README)
# SIGNUP_MODE=invite

# --- LLM (the local "codex" provider is refused in production) --------------------------------------
# AI_PROVIDER: anthropic | openai | openai-compatible. Without AI_API_KEY AI is off (the screens still work).
# anthropic needs AI_MODEL; openai-compatible needs AI_API_BASE_URL and AI_MODEL; openai defaults to
# gpt-4o-mini and, with another AI_API_BASE_URL, is treated as openai-compatible. There is no fallback model.
AI_PROVIDER=openai
AI_API_KEY=
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_REASONING_EFFORT=low           # openai / openai-compatible only; refused for anthropic
# AI_TIMEOUT_MS=120000              # one model call, at most 180000
# AI_MAX_INPUT_TOKENS=60000         # larger prompts are refused before anything is reserved
# GOVERNANCE_AI_ENABLED=false        # the governed-dashboard assistant stays off until this is true: an organization
#                                   # administrator may have allowed AI assuming a different processor
# REQUIRED when AI_API_KEY is set: the server-wide ceiling on tokens per UTC month, across all users.
# Once spent every AI call answers 503 until next month.
# AI_GLOBAL_MONTHLY_TOKENS=

# --- Per-user AI quota (UTC calendar day / month; 0 = no AI for that user). Per-user overrides:
#     access-cli quota set <userId> --daily N --monthly N. Defaults are placeholders until confirmed.
# QUOTA_DAILY_CALLS=30
# QUOTA_MONTHLY_TOKENS=500000

# --- Public links expire in at most 30 days. Days a link lasts when the owner sets no expiry (1-30)
# PUBLICATION_DEFAULT_DAYS=30

# --- Per-user, per-route requests a minute (in addition to the per-IP limit): AI routes / upload routes /
#     remix preview and save (the read preset covers the remix template)
# USER_THROTTLE_AI_PER_MIN=20
# USER_THROTTLE_UPLOAD_PER_MIN=5
# USER_THROTTLE_READ_PER_MIN=30
# USER_THROTTLE_REMIX_PER_MIN=30

# --- Per-user upload caps: uploaded sources, and bytes of stored files (every kept version, files awaiting
#     deletion cleanup, staged refresh inputs). Placeholders until confirmed.
# UPLOAD_MAX_SOURCES_PER_USER=20
# UPLOAD_MAX_BYTES_PER_USER=5368709120

# --- Observability (optional) ---------------------------------------------------------------------
SENTRY_DSN=

# Optional Google Docs. See docs/operations/google-documents.md. Empty values disable connection.
GOOGLE_DOCS_CLIENT_ID=
GOOGLE_DOCS_CLIENT_SECRET=
GOOGLE_DOCS_REDIRECT_URI=

# --- Backup (see backup.sh and README "백업과 복원 훈련", "키 보관") --------------------------------------
BACKUP_DIR=/var/backups/vanillameta
BACKUP_RETENTION_DAYS=14
# REQUIRED: file with the archive passphrase (chmod 600). Archives are always encrypted. Keep a copy of
# this passphrase and of this .env.prod OFF the VM and apart from the bucket, or off-site backups are useless.
BACKUP_PASSPHRASE_FILE=/etc/vanillameta/backup.pass
# Stop the api while dumping and copying so DuckDB files are not torn (default true)
# BACKUP_QUIESCE=true
# Optional off-site copy with the AWS CLI (R2/S3-compatible)
# BACKUP_S3_URI=s3://bucket/vanillameta
# BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
