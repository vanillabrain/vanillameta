# Copy to .env.prod (never commit it) and fill every value. Generate secrets with: openssl rand -hex 32
# docker compose refuses to start while a required value is empty.

# --- Public address -------------------------------------------------------------------------
APP_DOMAIN=app.example.com        # DNS A record must already point at this VM; Caddy gets the certificate
ACME_EMAIL=ops@example.com        # Let's Encrypt contact

# --- Images (set by the deploy workflow; pin a tag, never "latest") -------------------------------
IMAGE_TAG=
# API_IMAGE=ghcr.io/vanillabrain/vanillameta-api
# WEB_IMAGE=ghcr.io/vanillabrain/vanillameta-web

# --- Database -------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# MYSQL_DATABASE=vanillameta
# MYSQL_USER=vanillameta

# --- Application secrets (each at least 32 characters, no "dev-only-" prefix) ---------------------
ACCESS_SECRET=
REFRESH_SECRET=
JWT_ACCESS_SECRET=
URL_ACCESS_SECRET=
CONFIG_SECRET_KEY=

# --- Data sources: uploads and the sample only. Do not list network engines without egress-guard.sh
# ALLOWED_SOURCE_TYPES=file,sample

# --- LLM (the local "codex" provider is refused in production) --------------------------------------
AI_PROVIDER=openai
AI_API_KEY=
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# --- Observability (optional) ---------------------------------------------------------------------
SENTRY_DSN=

# --- Backup (see backup.sh) -----------------------------------------------------------------------
BACKUP_DIR=/var/backups/vanillameta
BACKUP_RETENTION_DAYS=14
# Encrypt archives before they leave the VM: path to a file that contains a passphrase (chmod 600)
# BACKUP_PASSPHRASE_FILE=/etc/vanillameta/backup.pass
# Optional off-site copy with the AWS CLI (R2/S3-compatible)
# BACKUP_S3_URI=s3://bucket/vanillameta
# BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
