DB_TYPE='mysql'
DB_HOST='hostHere'
DB_PORT=3306
DB_USERNAME='userHere'
DB_PASSWORD='passwordHere'
DB_NAME='vanillameta'

# Connection Pool Settings (Lambda optimized)
DB_CONNECTION_LIMIT=5  # TypeORM connection pool size (default: 5)
KNEX_POOL_MAX=3       # Knex connection pool max size per database (default: 3)

# Slow Query Monitoring
SLOW_QUERY_THRESHOLD=1000  # Milliseconds (default: 1000ms = 1 second)
SLOW_QUERY_MONITORING_ENABLED=true  # Enable/disable slow query monitoring

ACCESS_SECRET=accessHere
REFRESH_SECRET=refreshHere
JWT_ACCESS_SECRET=jwtAccessHere
URL_ACCESS_SECRET=urlAccessHere
CORS_ORIGIN = "http://localhost:3000, https://demo.vanillameta.net, https://addMore"
