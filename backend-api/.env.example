DB_TYPE='mysql'
DB_HOST='hostHere'
DB_PORT=3306
DB_USERNAME='userHere'
DB_PASSWORD='passwordHere'
DB_NAME='vanillameta'

ACCESS_SECRET=accessHere
REFRESH_SECRET=refreshHere
JWT_ACCESS_SECRET=jwtAccessHere
URL_ACCESS_SECRET=urlAccessHere
CORS_ORIGIN = "http://localhost:3000, https://demo.vanillameta.net, https://addMore"

# DB 접속정보 암호화 키 (미설정 시 ACCESS_SECRET 사용)
CONFIG_SECRET_KEY=configSecretHere

# 사용자 쿼리 실행 타임아웃(ms). 기본 60000
QUERY_TIMEOUT_MS=60000

# true로 설정하면 SELECT 이외 쓰기 쿼리도 허용 (기본: 읽기 전용만 허용)
QUERY_ALLOW_WRITE=false

# API rate limit (윈도우 초 / 윈도우당 최대 요청 수)
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# AI 어시스턴트 (text-to-SQL) — OpenAI 호환 API
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# 쿼리 결과 캐시 TTL(ms) — 0이면 비활성 (기본 0)
QUERY_CACHE_TTL_MS=0

# Sentry 에러 트래킹 (미설정 시 비활성)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# 파일 업로드 → sqlite 데이터소스 저장 경로 (기본 <cwd>/uploads)
FILE_UPLOAD_DIR=
