# 앱 리슨 포트 (기본 4000)
PORT=4000

# NODE_ENV=local 이면 외부 DB 없이 SQLite로 동작
SQLITE_PATH=sqlite.db

DB_TYPE='mysql'
DB_HOST='hostHere'
DB_PORT=3306
DB_USERNAME='userHere'
DB_PASSWORD='passwordHere'
DB_NAME='vanillameta'

# Connection Pool Settings (Lambda optimized)
DB_CONNECTION_LIMIT=5  # TypeORM connection pool size (default: 5)
KNEX_POOL_MAX=3       # Knex connection pool max size per database (default: 3)

# Slow Query Monitoring
SLOW_QUERY_THRESHOLD=1000  # Milliseconds (default: 1000ms = 1 second)
SLOW_QUERY_MONITORING_ENABLED=true  # Enable/disable slow query monitoring

ACCESS_SECRET=accessHere
REFRESH_SECRET=refreshHere
JWT_ACCESS_SECRET=jwtAccessHere
URL_ACCESS_SECRET=urlAccessHere
CORS_ORIGIN = "http://localhost:3000, https://demo.vanillameta.net, https://addMore"

# DB 접속정보 암호화 키 (미설정 시 ACCESS_SECRET 사용)
CONFIG_SECRET_KEY=configSecretHere

# 사용자 쿼리 실행 타임아웃(ms). 기본 60000
QUERY_TIMEOUT_MS=60000

# true로 설정하면 SELECT 이외 쓰기 쿼리도 허용 (기본: 읽기 전용만 허용)
QUERY_ALLOW_WRITE=false

# API rate limit (윈도우 초 / 윈도우당 최대 요청 수)
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# AI 어시스턴트 (text-to-SQL) — OpenAI 호환 API
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# 사용자별 AI 쿼터 (UTC 달력 일/월 기준, 0이면 해당 사용자 AI 사용 불가). 기본값은 확정 전 값
# QUOTA_DAILY_CALLS=30
# QUOTA_MONTHLY_TOKENS=500000

# 공개 링크 만료: 최대 30일. 만료를 지정하지 않았을 때의 기본 일수(1-30)
# PUBLICATION_DEFAULT_DAYS=30

# Local Codex AI: copy these settings into untracked .env.local when using it.
# Uses the existing Codex login and fixed gpt-6-luna; no model fallback.
# AI_PROVIDER=codex
# AI_CODEX_BASE_URL=http://127.0.0.1:10100/v1
# AI_CODEX_MODEL_CATALOG=/absolute/path/to/your/opencodex-catalog.json
# AI_TIMEOUT_MS=180000

# 쿼리 결과 캐시 TTL(ms) — 0이면 비활성 (기본 0)
QUERY_CACHE_TTL_MS=0
# 설정 시 쿼리 결과 캐시를 Redis로 공유 (미설정 시 인메모리)
REDIS_URL=

# Legacy Redis/Bull jobs are opt-in via REDIS_URL or explicit REDIS_HOST/REDIS_PORT.
# Without Redis, history remains readable and job admission returns HTTP 503.
# L2 monitoring reports disabled when Redis is not configured. In dev/prod an
# explicit endpoint enables L2; REDIS_CACHE_ENABLED=false disables it. Local
# mode requires REDIS_CACHE_ENABLED=true to opt in. Zero traffic is not a low hit rate.
# Global diagnostics require current JWT plus an explicit positive user ID allowlist.
# Empty by default; organization admin status does not grant server operations access.
LEGACY_OPERATIONS_USER_IDS=

# Sentry 에러 트래킹 (미설정 시 비활성)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# 파일 업로드 → sqlite 데이터소스 저장 경로 (기본 <cwd>/uploads)
FILE_UPLOAD_DIR=
