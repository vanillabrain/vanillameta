{
  "name": "backend-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc --noEmit && node --require ./scripts/typescript-api-compat.cjs ./node_modules/@nestjs/cli/bin/nest.js build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node --require ./scripts/typescript-api-compat.cjs ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:dev": "cross-env NODE_ENV=dev node --require ./scripts/typescript-api-compat.cjs ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:local": "cross-env NODE_ENV=local node --require ./scripts/typescript-api-compat.cjs ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:debug": "node --require ./scripts/typescript-api-compat.cjs ./node_modules/@nestjs/cli/bin/nest.js start --debug --watch",
    "start:prod": "cross-env NODE_ENV=prod node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --config package.json",
    "test:watch": "jest --config package.json --watch",
    "test:cov": "jest --config package.json --coverage",
    "test:debug": "node --inspect-brk --require ./scripts/typescript-api-compat.cjs -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --config package.json --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:fast": "jest --config jest.config.fast.js",
    "test:unit": "jest --config package.json --testPathPattern='controller\\.spec\\.ts$|service\\.spec\\.ts$' --testTimeout=30000",
    "test:integration": "jest --config package.json --testPathPattern='integration\\.spec\\.ts$'",
    "deploy": "serverless deploy --stage prod",
    "seed": "cross-env NODE_ENV=local node --require ./scripts/typescript-api-compat.cjs -r ts-node/register -r tsconfig-paths/register src/database/run-seed.ts",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:prod": "serverless deploy --stage prod",
    "yolo": "./scripts/yolo-mode.sh",
    "quick": "./scripts/quick-check.sh",
    "test:baseline": "yarn test:unit && echo '\u2705 \ubaa8\ub4e0 \ubca0\uc774\uc2a4\ub77c\uc778 \ud14c\uc2a4\ud2b8 \ud1b5\uacfc!'",
    "monitor:lambda": "node scripts/monitor-lambda-performance.js",
    "monitor:performance": "node scripts/monitor-lambda-performance.js",
    "test:slow-query": "cross-env NODE_ENV=dev node --require ./scripts/typescript-api-compat.cjs -r ts-node/register -r tsconfig-paths/register src/test-slow-query.ts",
    "deploy:dashboard:dev": "./scripts/deploy-cloudwatch-dashboard.sh dev",
    "deploy:dashboard:prod": "./scripts/deploy-cloudwatch-dashboard.sh prod",
    "test:performance": "jest --config package.json --testPathPattern='performance.*\\.spec\\.ts$' --testTimeout=60000",
    "test:load": "jest --config package.json --testPathPattern='load-testing\\.spec\\.ts$' --testTimeout=60000",
    "test:stress": "jest --config package.json --testPathPattern='enhanced-load-testing\\.spec\\.ts$' --testTimeout=60000",
    "artillery:run": "artillery run test/performance/artillery/artillery.yml",
    "artillery:report": "artillery run test/performance/artillery/artillery.yml --output artillery-report.json && artillery report artillery-report.json",
    "k6:load": "k6 run test/performance/k6/load-test.js",
    "k6:stress": "k6 run test/performance/k6/stress-test.js",
    "k6:cloud": "k6 cloud test/performance/k6/load-test.js",
    "performance:all": "yarn test:performance && yarn artillery:run && yarn k6:load",
    "migration:run": "node --require ./scripts/typescript-api-compat.cjs -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/data-source.ts",
    "access:cli": "node dist/src/access/access-cli.js",
    "migration:run:prod": "cross-env NODE_ENV=prod node dist/src/database/migrate-prod.js",
    "migration:revert": "node --require ./scripts/typescript-api-compat.cjs -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/data-source.ts",
    "migration:mysql-to-postgres": "node scripts/migrate-mysql-to-postgres.cjs",
    "migration:generate": "node --require ./scripts/typescript-api-compat.cjs -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d src/data-source.ts",
    "test:legacy": "jest --config jest.config.js",
    "typecheck": "tsc --noEmit",
    "test:toolchain": "node --test scripts/typescript-api-compat.test.cjs",
    "start:prod:oracle-thick": "cross-env NODE_ENV=prod node --require ./scripts/oracle-thick.cjs dist/src/main"
  },
