{
  "name": "backend-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start --watch",
    "start:dev": "cross-env NODE_ENV=dev nest start --watch",
    "start:local": "cross-env NODE_ENV=local nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=prod node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --config package.json",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:fast": "jest --config jest.config.fast.js",
    "test:unit": "jest --testPathPattern='controller\\.spec\\.ts$|service\\.spec\\.ts$' --testTimeout=30000",
    "test:integration": "jest --testPathPattern='integration\\.spec\\.ts$'",
    "deploy": "serverless deploy --stage prod",
    "seed": "cross-env NODE_ENV=local ts-node -r tsconfig-paths/register src/database/run-seed.ts",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:prod": "serverless deploy --stage prod",
    "yolo": "./scripts/yolo-mode.sh",
    "quick": "./scripts/quick-check.sh",
    "test:baseline": "yarn test:unit && echo '✅ 모든 베이스라인 테스트 통과!'",
    "monitor:lambda": "node scripts/monitor-lambda-performance.js",
    "monitor:performance": "node scripts/monitor-lambda-performance.js",
    "test:slow-query": "cross-env NODE_ENV=dev ts-node -r tsconfig-paths/register src/test-slow-query.ts",
    "deploy:dashboard:dev": "./scripts/deploy-cloudwatch-dashboard.sh dev",
    "deploy:dashboard:prod": "./scripts/deploy-cloudwatch-dashboard.sh prod",
    "test:performance": "jest --testPathPattern='performance.*\\.spec\\.ts$' --testTimeout=60000",
    "test:load": "jest --testPathPattern='load-testing\\.spec\\.ts$' --testTimeout=60000",
    "test:stress": "jest --testPathPattern='enhanced-load-testing\\.spec\\.ts$' --testTimeout=60000",
    "artillery:run": "artillery run test/performance/artillery/artillery.yml",
    "artillery:report": "artillery run test/performance/artillery/artillery.yml --output artillery-report.json && artillery report artillery-report.json",
    "k6:load": "k6 run test/performance/k6/load-test.js",
    "k6:stress": "k6 run test/performance/k6/stress-test.js",
    "k6:cloud": "k6 cloud test/performance/k6/load-test.js",
    "performance:all": "yarn test:performance && yarn artillery:run && yarn k6:load",
    "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/data-source.ts",
    "migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/data-source.ts",
    "migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d src/data-source.ts",
    "test:legacy": "jest --config jest.config.js"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.26",
    "@duckdb/node-api": "1.5.6-r.1",
    "@google-cloud/bigquery": "^6.0.3",
    "@nestjs-modules/ioredis": "^2.3.1",
    "@nestjs/axios": "^3.0.0",
    "@nestjs/bull": "^10.0.0",
    "@nestjs/cache-manager": "^2.3.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/mapped-types": "^2.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.0.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/throttler": "^4.2.1",
    "@nestjs/typeorm": "^12.0.2",
    "@nestjs/websockets": "^10.0.0",
    "@nestjsplus/knex": "^1.0.0",
    "@sentry/nestjs": "^8.55.2",
    "@types/cookie-parser": "^1.4.3",
    "@types/mustache": "^4.2.1",
    "@types/ua-parser-js": "^0.7.39",
    "@types/validator": "^13.15.1",
    "@types/winston": "^2.4.4",
    "ai": "^7.0.137",
    "aws-lambda": "^1.0.7",
    "aws-serverless-express": "^3.4.0",
    "axios": "^1.6.0",
    "bluebird": "^3.7.2",
    "buffer-equal-constant-time": "file:./patches/buffer-equal-constant-time-1.0.2.tgz",
    "bull": "^4",
    "cache-manager": "^5.7.6",
    "cache-manager-redis-yet": "^5.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cross-env": "^7.0.3",
    "dylib-node": "^1.0.10",
    "fastify-swagger": "^5.2.0",
    "helmet": "^7.2.0",
    "ioredis": "^5.11.1",
    "js-joda": "^1.11.0",
    "knex": "^2.3.0",
    "knex-bigquery": "^2.0.3",
    "knex-db2": "^1.0.0",
    "knex-schema-inspector": "^2.0.4",
    "lru-cache": "^11.1.0",
    "lz-string": "^1.5.0",
    "mathjs": "^15.2.0",
    "multer": "^2.4.0",
    "mustache": "^4.2.0",
    "mysql2": "^2.3.3",
    "nest-winston": "^1.7.0",
    "nestjs-i18n": "^10.8.5",
    "parquetjs-lite": "^0.8.7",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.8.0",
    "redis": "^5.5.6",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.2.0",
    "sequelize": "^6.25.0",
    "sequelize-oracle": "^3.3.2-0.0",
    "sequelize-typescript": "^2.1.3",
    "snowflake-sdk": "^1.6.13",
    "socket.io": "^4.8.4",
    "sqlite3": "^5.1.4",
    "swagger-ui-express": "^4.5.0",
    "tedious": "^15.1.0",
    "ts-jenum": "^2.2.2",
    "typeorm": "^0.3.9",
    "typeorm-naming-strategies": "^4.1.0",
    "ua-parser-js": "^2.0.3",
    "uuid": "^9.0.0",
    "winston": "^3.8.2",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "odbc": "^2.4.6",
    "oracledb": "^5.5.0"
  },
  "overrides": {
    "buffer-equal-constant-time": "$buffer-equal-constant-time"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/compression": "^1.7.2",
    "@types/express": "^4.17.13",
    "@types/jest": "28.1.8",
    "@types/node": "^16.0.0",
    "@types/passport-jwt": "^3.0.7",
    "@types/passport-local": "^1.0.34",
    "@types/supertest": "^2.0.11",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "aws-sdk": "^2.1239.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "28.1.3",
    "prettier": "^2.3.2",
    "serverless": "^3.38.0",
    "serverless-domain-manager": "^5.1.5",
    "serverless-http": "^2.7.0",
    "serverless-latest-layer-version": "^2.1.1",
    "serverless-offline": "^8.2.0",
    "serverless-plugin-optimize": "^4.2.1-rc.1",
    "serverless-plugin-typescript": "^2.1.0",
    "serverless-plugin-warmup": "^6.0.0",
    "serverless-webpack": "^5.5.5",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.3",
    "ts-jest": "28.0.8",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.1.0",
    "typeorm-extension": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "moduleNameMapper": {
      "^buffer-equal-constant-time$": "<rootDir>/test/shims/buffer-equal-constant-time.js",
      "^src/(.*)$": "<rootDir>/src/$1",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testTimeout": 20000,
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "/node_modules/@nestjs/typeorm/.+\\.js$": "<rootDir>/test/typeorm-esm-transformer.cjs",
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/test/"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!@nestjs/typeorm/)"
    ]
  },
  "engines": {
    "node": ">=24.11.0 <25"
  }
}
