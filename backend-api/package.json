  },
  "optionalDependencies": {
    "odbc": "^2.4.6",
    "oracledb": "^26.0.0"
  },
  "overrides": {
    "buffer-equal-constant-time": "$buffer-equal-constant-time"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
