    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.1.0",
    "typeorm-extension": "^2.8.1",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@5.9.3"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "moduleNameMapper": {
      "^buffer-equal-constant-time$": "<rootDir>/test/shims/buffer-equal-constant-time.js",
      "^src/(.*)$": "<rootDir>/src/$1",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testTimeout": 20000,
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "/node_modules/@nestjs/typeorm/.+\\.js$": "<rootDir>/test/typeorm-esm-transformer.cjs",
      "^.+\\.(t|j)s$": "<rootDir>/test/ts-jest-transformer.cjs"
    },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "testPathIgnorePatterns": ["/node_modules/", "<rootDir>/test/"],
    "transformIgnorePatterns": ["/node_modules/(?!@nestjs/typeorm/)"],
    "globals": {
      "ts-jest": {
        "compiler": "typescript-api"
      }
    }
  },
  "engines": {
    "node": ">=24.11.0 <25"
  }
}
