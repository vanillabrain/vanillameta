# Docker Compose 환경 변수 템플릿
# 이 파일을 복사하여 사용하세요: cp .env.docker .env

# 데이터베이스 설정
DB_TYPE=mysql
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=vanillameta
DB_PASSWORD=your_secure_password_here
DB_NAME=vanillameta
DB_ROOT_PASSWORD=your_root_password_here

# Redis 설정
REDIS_HOST=redis
REDIS_PORT=6379

# Connection Pool 설정 (Lambda 최적화)
DB_CONNECTION_LIMIT=5
KNEX_POOL_MAX=3

# JWT 및 보안 설정
ACCESS_SECRET=your_access_secret_here
REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_SECRET=your_jwt_secret_here
URL_ACCESS_SECRET=your_url_secret_here

# CORS 설정
CORS_ORIGIN=http://localhost:3001,https://your-domain.com

# 노드 환경
NODE_ENV=development