#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# 현재 브랜치 확인
branch="$(git rev-parse --abbrev-ref HEAD)"

# main 브랜치로의 merge 방지
if [ "$branch" = "main" ]; then
  echo "❌ main 브랜치에서 직접 merge할 수 없습니다!"
  echo "✅ GitHub에서 Pull Request를 통해 merge해주세요:"
  echo "   1. GitHub에서 PR 생성"
  echo "   2. 코드 리뷰 진행"
  echo "   3. PR을 통해 merge"
  echo ""
  echo "📌 작업 브랜치는 'develop-refactor-<feature>'로 생성하고"
  echo "   PR의 target은 'develop-refactor'로 설정해주세요."
  exit 1
fi

echo "✅ 브랜치 '$branch'에서 merge를 진행합니다..."