    {
      "type": "log",
      "x": 0,
      "y": 12,
      "width": 24,
      "height": 6,
      "properties": {
        "query": "SOURCE '/aws/lambda/vanillameta-backend-api-dev'\n| fields @timestamp, @message\n| filter @message like /Slow query detected/\n| stats count() by bin(5m)",
        "region": "us-east-1",
        "title": "슬로우 쿼리 로그 (5분 단위)",
        "queryType": "Logs"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 18,
      "width": 12,
      "height": 6,
      "properties": {
        "metrics": [
          [ { "expression": "SEARCH(' {VanillaMeta/dev/Database, Severity} MetricName=\"SlowQueryBySeverity\" Severity=\"CRITICAL\" ', 'Sum', 300)", "id": "e1", "label": "Critical", "color": "#d62728" } ],
          [ { "expression": "SEARCH(' {VanillaMeta/dev/Database, Severity} MetricName=\"SlowQueryBySeverity\" Severity=\"HIGH\" ', 'Sum', 300)", "id": "e2", "label": "High", "color": "#ff7f0e" } ],
          [ { "expression": "SEARCH(' {VanillaMeta/dev/Database, Severity} MetricName=\"SlowQueryBySeverity\" Severity=\"MEDIUM\" ', 'Sum', 300)", "id": "e3", "label": "Medium", "color": "#ffbb78" } ],
          [ { "expression": "SEARCH(' {VanillaMeta/dev/Database, Severity} MetricName=\"SlowQueryBySeverity\" Severity=\"LOW\" ', 'Sum', 300)", "id": "e4", "label": "Low", "color": "#2ca02c" } ]
        ],
        "view": "timeSeries",
        "stacked": true,
        "region": "us-east-1",
        "title": "시간대별 심각도 트렌드",
        "period": 300
      }
