# SQLite Local Environment Configuration
NODE_ENV=local
DB_TYPE=sqlite
DB_NAME=sqlite.db

# JWT and Security
ACCESS_SECRET=local-access-secret-key
REFRESH_SECRET=local-refresh-secret-key
JWT_ACCESS_SECRET=local-jwt-access-secret-key
URL_ACCESS_SECRET=local-url-access-secret-key

# CORS Configuration for local development
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:4000

# Logging
LOG_LEVEL=debug

# Redis (local)
REDIS_HOST=localhost
REDIS_PORT=6379