# Local Development Environment (SQLite)
# NODE_ENV=local will automatically use SQLite

# CORS 설정 (로컬 개발)
CORS_ORIGIN="http://localhost:3000, http://localhost:4000"

# JWT 시크릿 (로컬 개발용 - 동일하게 유지)
ACCESS_SECRET=local_access_secret_123
REFRESH_SECRET=local_refresh_secret_456
JWT_ACCESS_SECRET=local_jwt_access_secret_789
URL_ACCESS_SECRET=local_url_access_secret_000

# Connection Pool Settings (SQLite 로컬 개발)
DB_CONNECTION_LIMIT=1
KNEX_POOL_MAX=1
