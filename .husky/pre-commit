#!/bin/bash

# 현재 브랜치 확인
current_branch=$(git symbolic-ref HEAD 2>/dev/null | cut -d"/" -f 3)

echo "🔍 Checking branch: $current_branch"

# main 브랜치에서 커밋 방지
if [ "$current_branch" = "main" ]; then
    echo "🚫 ERROR: Direct commits to 'main' branch are not allowed!"
    echo "📝 Please create a feature branch for your changes."
    echo ""
    echo "You can create a new branch with:"
    echo "  git checkout -b feature/your-feature-name"
    echo ""
    exit 1
fi

# 빌드 검증 (선택적 - 환경변수로 활성화 가능)
if [ "$HUSKY_BUILD_CHECK" = "true" ]; then
    echo "🔨 Running build verification..."
    
    # Backend build check
    if [ -d "backend-api" ]; then
        echo "  📦 Checking backend build..."
        cd backend-api && yarn build > /dev/null 2>&1
        if [ $? -ne 0 ]; then
            echo "  ❌ Backend build failed! Please fix build errors before committing."
            exit 1
        fi
        cd ..
    fi
    
    # Frontend build check
    if [ -d "frontend-web" ]; then
        echo "  📦 Checking frontend build..."
        cd frontend-web && yarn build > /dev/null 2>&1
        if [ $? -ne 0 ]; then
            echo "  ❌ Frontend build failed! Please fix build errors before committing."
            exit 1
        fi
        cd ..
    fi
    
    echo "  ✅ Build verification passed."
fi

echo "✅ Pre-commit validation passed."