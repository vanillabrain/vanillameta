# Production web image: the SPA plus an nginx that proxies the API on the same origin, so one image
# serves any domain. Dev and CI flows keep using Dockerfile / Dockerfile.dev.
FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps
COPY . .
# Relative on purpose: the API is proxied under /v1 on the page's own origin.
ARG REACT_APP_API_URL=/v1
ARG REACT_APP_MODE=prod
ARG REACT_APP_SENTRY_DSN=
ARG REACT_APP_SENTRY_TRACES_SAMPLE_RATE=0
ENV REACT_APP_API_URL=$REACT_APP_API_URL \
    REACT_APP_MODE=$REACT_APP_MODE \
    REACT_APP_SENTRY_DSN=$REACT_APP_SENTRY_DSN \
    REACT_APP_SENTRY_TRACES_SAMPLE_RATE=$REACT_APP_SENTRY_TRACES_SAMPLE_RATE
RUN npm run build

FROM nginx:1.28-alpine
COPY --from=build /app/build /usr/share/nginx/html
# The API host is resolved when nginx starts; the template is rendered from the API_UPSTREAM variable.
COPY nginx.prod.conf /etc/nginx/templates/default.conf.template
ENV API_UPSTREAM=api:4000 \
    NGINX_ENVSUBST_FILTER=API_UPSTREAM
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1/healthz >/dev/null || exit 1
