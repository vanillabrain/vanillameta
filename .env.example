# docker compose up 이 읽는 선택 변수. 모두 기본값이 있어 이 파일 없이도 동작한다.
# 바꾸고 싶은 값만 .env 로 복사해 수정한다:  cp .env.example .env
# (backend-api/.env.example 은 docker 없이 직접 실행할 때의 변수 목록이다.)

# ── 웹 노출 ─────────────────────────────────────────────
# 기본은 이 PC에서만 접속(127.0.0.1). 0.0.0.0 은 신뢰하는 LAN에서만 쓰고 비밀값 5개를 먼저 바꾼다.
# dev 모드는 데모 계정을 GET /v1/ 로 알려 주고 회원가입이 열려 있어 인터넷 공개용이 아니다(공개는 deploy/).
VM_BIND=127.0.0.1
VM_WEB_PORT=3000
# 웹 포트를 바꾸면 같은 오리진으로 맞춘다.
CORS_ORIGIN=http://localhost:3000

# ── 조직 관리 모드 ──────────────────────────────────────
# 기본값은 guest 다. 이 로그인 ID 의 계정만 조직을 만들 수 있고(시드가 guest 를 조직 admin 으로 연결한다),
# 조직에 속하지 않은 계정은 서비스를 쓸 수 없다. 조직 admin 이 직원으로 추가하고 등급
# (admin, editor, contributor, viewer)을 정한다. 값을 비우면(BOOTSTRAP_ADMIN_USER_ID=) 예전처럼
# 누구나 조직을 만들고 조직 없이도 쓸 수 있다. 계정이 아직 없는데 SIGNUP_MODE 가 open 이면 부팅을 거부한다.
BOOTSTRAP_ADMIN_USER_ID=guest

# ── 메타데이터 DB (PostgreSQL 17) ───────────────────────
# 처음 볼륨을 만들 때 적용된다. 바꾼 뒤에는 docker compose down -v 로 초기화해야 반영된다.
DB_NAME=vanillameta
DB_USERNAME=vanillameta
DB_PASSWORD=vanillameta

# ── 비밀값 (각 32자 이상 권장, 노출 전 반드시 변경) ─────
# 처음 띄우기 전에 정한다. CONFIG_SECRET_KEY 는 저장된 연결 정보를 암호화하므로
# 나중에 바꾸면 기존 데이터를 읽지 못해 docker compose down -v 로 초기화해야 한다.
ACCESS_SECRET=dev-only-access-secret
REFRESH_SECRET=dev-only-refresh-secret
JWT_ACCESS_SECRET=dev-only-jwt-secret
URL_ACCESS_SECRET=dev-only-url-secret
CONFIG_SECRET_KEY=dev-only-config-secret

# ── AI 어시스턴트 (선택, 키가 없으면 AI 기능만 꺼짐) ────
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_API_BASE_URL=

# ── 쿼리 결과 캐시 (선택) ───────────────────────────────
# 쿼리 결과 캐시와 백그라운드 작업 큐(Bull)를 함께 켠다.
# 쓰려면 REDIS_URL=redis://redis:6379 와 COMPOSE_PROFILES=cache 를 같이 설정한다(둘 중 하나만 있으면 안 된다).
REDIS_URL=

# ── 빌드 ────────────────────────────────────────────────
# TypeScript 컴파일용 힙(MB). 힙 외 여유가 필요하므로 Docker 메모리는 4GB 이상을 권한다(실측하지 않았다).
BUILD_HEAP_MB=3072
