# VanillaMeta Docker 환경 변수 설정 예제
# 이 파일을 .env로 복사하고 필요에 따라 값을 수정하세요

# 기본 설정
NODE_ENV=local
TZ=Asia/Seoul

# 백엔드 설정
BACKEND_PORT=3000
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=your-refresh-secret-key-here
JWT_REFRESH_EXPIRATION=7d

# 데이터베이스 설정
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=vanillameta
DB_CONNECTION_LIMIT=10

# Redis 설정
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# 프론트엔드 설정
REACT_APP_API_URL=http://localhost/api/v1
REACT_APP_MODE=local

# Nginx 설정
NGINX_PORT=80
NGINX_SSL_PORT=443