export default NewChartSetting;
```

### Chart Registry Pattern (MUST UPDATE)
```typescript
// Update: widget/utils/switchChart.tsx
export const switchChart = (type: string, data: any, options: any) => {
  switch (type) {
    case 'newChart':
      return <NewChart data={data} options={options} />;
    // ... other cases
    default:
      return null;
  }
};
```

## 🔒 SECURITY PATTERNS

### Authentication Guard Pattern (MUST USE)
```typescript
// Example: jwt-auth.guard.ts
@Injectable()
export class JwtAuthGuard extends AuthGuard('jwt') {
  canActivate(context: ExecutionContext) {
    // Custom authentication logic
    return super.canActivate(context);
  }

  handleRequest(err: any, user: any, info: any) {
    if (err || !user) {
      throw err || new UnauthorizedException();
    }
    return user;
  }
}
```

### Input Validation Pattern (MUST IMPLEMENT)
```typescript
// Example: create-dashboard.dto.ts
export class CreateDashboardDto {
  @IsString()
  @IsNotEmpty()
  @MaxLength(255)
  title: string;

  @IsOptional()
  @IsObject()
  config?: DashboardConfig;

  @IsNumber()
  @IsPositive()
  userId: number;
}
```

