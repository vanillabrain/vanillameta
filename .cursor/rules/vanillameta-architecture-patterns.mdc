}
```

## 🧪 TESTING PATTERNS

### Service Testing Pattern (MUST FOLLOW)
```typescript
// Example: analytics.service.spec.ts
describe('AnalyticsService', () => {
  let service: AnalyticsService;
  let repository: Repository<AnalyticsEntity>;

  beforeEach(async () => {
    const module: TestingModule = await Test.createTestingModule({
      providers: [
        AnalyticsService,
        {
          provide: getRepositoryToken(AnalyticsEntity),
          useClass: Repository,
        },
      ],
    }).compile();

    service = module.get<AnalyticsService>(AnalyticsService);
    repository = module.get<Repository<AnalyticsEntity>>(
      getRepositoryToken(AnalyticsEntity),
    );
  });

  it('should fetch analytics data', async () => {
    // Arrange
    const mockData = [{ id: 1, value: 100 }];
    jest.spyOn(repository, 'find').mockResolvedValue(mockData as any);

    // Act
    const result = await service.getAnalytics({});

    // Assert
    expect(result).toEqual(mockData);
    expect(repository.find).toHaveBeenCalled();
  });
});
```

