# VanillaMeta Architecture Patterns

## 🏗️ MANDATORY ARCHITECTURAL PATTERNS

### NestJS Backend Patterns

#### Module Structure (MUST FOLLOW)
```typescript
// Example: analytics.module.ts
@Module({
  imports: [TypeOrmModule.forFeature([AnalyticsEntity])],
  controllers: [AnalyticsController],
  providers: [AnalyticsService],
  exports: [AnalyticsService], // Export if used by other modules
})
export class AnalyticsModule {}
```

#### Controller Pattern (MUST IMPLEMENT)
```typescript
// Example: analytics.controller.ts
@Controller('analytics')
@UseGuards(JwtAuthGuard) // Apply authentication
export class AnalyticsController {
  constructor(private readonly analyticsService: AnalyticsService) {}

  @Get()
  @ApiOperation({ summary: 'Get analytics data' }) // Swagger documentation
  async getAnalytics(@Query() query: GetAnalyticsDto) {
    return this.analyticsService.getAnalytics(query);
  }
}
```

#### Service Pattern (MUST IMPLEMENT)
```typescript
// Example: analytics.service.ts
@Injectable()
export class AnalyticsService {
  private readonly logger = new Logger(AnalyticsService.name);

  constructor(
    @InjectRepository(AnalyticsEntity)
    private analyticsRepository: Repository<AnalyticsEntity>,
  ) {}

  async getAnalytics(query: GetAnalyticsDto): Promise<AnalyticsResponse> {
    try {
      // Business logic here
      this.logger.debug('Fetching analytics data');
      return await this.analyticsRepository.find(query);
    } catch (error) {
      this.logger.error('Failed to fetch analytics', error);
      throw new InternalServerErrorException('Analytics fetch failed');
    }
  }
}
```

### React Frontend Patterns

#### Component Structure (MUST FOLLOW)
```typescript
// Example: DashboardWidget.tsx
interface IDashboardWidgetProps {
  data: ChartData;
  options: ChartOptions;
  onConfigChange?: (config: WidgetConfig) => void;
}

const DashboardWidget: React.FC<IDashboardWidgetProps> = ({ 
  data, 
  options, 
  onConfigChange 
}) => {
  const chartRef = useRef<HTMLDivElement>(null);
  
  useEffect(() => {
    const chart = echarts.init(chartRef.current);
    chart.setOption(options);
    
    return () => chart.dispose(); // Cleanup
  }, [data, options]);

  return <div ref={chartRef} style={{ width: '100%', height: '100%' }} />;
};

export default React.memo(DashboardWidget); // Performance optimization
```

#### Custom Hook Pattern (MUST USE)
```typescript
// Example: useChartData.ts
export const useChartData = (datasetId: string) => {
  const [data, setData] = useState<ChartData | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    const fetchData = async () => {
      setLoading(true);
      setError(null);
      
      try {
        const result = await chartService.getChartData(datasetId);
        setData(result);
      } catch (err) {
        setError(err.message);
      } finally {
        setLoading(false);
      }
    };

    if (datasetId) {
      fetchData();
    }
  }, [datasetId]);

  return { data, loading, error, refetch: () => fetchData() };
};
```

## 🔧 DATABASE & ORM PATTERNS

### Entity Definition (MUST FOLLOW)
```typescript
// Example: dashboard.entity.ts
@Entity('dashboards')
export class Dashboard {
  @PrimaryGeneratedColumn()
  id: number;

  @Column({ type: 'varchar', length: 255 })
  title: string;

  @Column({ type: 'json', nullable: true })
  config: DashboardConfig;

  @CreateDateColumn()
  createdAt: Date;

  @UpdateDateColumn()
  updatedAt: Date;

  @ManyToOne(() => User, user => user.dashboards)
  @JoinColumn({ name: 'user_id' })
  user: User;
}
```

### Repository Pattern (MUST USE)
```typescript
// Example: dashboard.service.ts
@Injectable()
export class DashboardService {
  constructor(
    @InjectRepository(Dashboard)
    private dashboardRepository: Repository<Dashboard>,
  ) {}

  async findByUserId(userId: number): Promise<Dashboard[]> {
    return this.dashboardRepository.find({
      where: { user: { id: userId } },
      relations: ['user'],
      order: { createdAt: 'DESC' },
    });
  }
}
```

### Knex Query Builder Pattern (for complex queries)
```typescript
// Example: connection.service.ts - following existing pattern
async executeComplexQuery(connection: any, query: ComplexQueryDto) {
  const knexQuery = connection('table')
    .select('*')
    .where('status', 'active')
    .orderBy('created_at', 'desc');
    
  return await knexQuery;
}
```

## 📊 WIDGET & CHART PATTERNS

### Chart Component Pattern (MUST FOLLOW)
Based on existing widget structure in [frontend-web/src/widget](mdc:frontend-web/src/widget):

```typescript
// Example: NewChart.tsx
interface INewChartProps {
  data: ChartData;
  options: ChartOptions;
}

const NewChart: React.FC<INewChartProps> = ({ data, options }) => {
  const chartRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    const chart = echarts.init(chartRef.current);
    
    const chartOptions = {
      ...options,
      // ECharts specific configuration
    };

    chart.setOption(chartOptions);

    return () => {
      chart.dispose();
    };
  }, [data, options]);

  return <div ref={chartRef} style={{ width: "100%", height: "100%" }} />;
};

export default NewChart;
```

### Chart Settings Pattern (MUST IMPLEMENT)
```typescript
// Example: NewChartSetting.tsx
