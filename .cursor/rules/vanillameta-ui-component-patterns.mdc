// Example: LineChart.tsx
import React from 'react';
import BaseChart from './BaseChart';
import { EChartsOption } from 'echarts';

interface ILineChartProps {
  data: {
    xAxis: string[];
    series: Array<{
      name: string;
      data: number[];
      color?: string;
    }>;
  };
  title?: string;
  smooth?: boolean;
  showGrid?: boolean;
}

const LineChart: React.FC<ILineChartProps> = ({
  data,
  title,
  smooth = false,
  showGrid = true,
}) => {
  const options: EChartsOption = {
    title: title ? { text: title } : undefined,
    tooltip: {
      trigger: 'axis',
      axisPointer: {
        type: 'cross',
      },
    },
    legend: {
      data: data.series.map(s => s.name),
    },
    grid: {
      show: showGrid,
      left: '3%',
      right: '4%',
      bottom: '3%',
      containLabel: true,
    },
    xAxis: {
      type: 'category',
      data: data.xAxis,
    },
    yAxis: {
      type: 'value',
    },
    series: data.series.map(series => ({
      name: series.name,
      type: 'line',
      data: series.data,
      smooth,
      itemStyle: {
        color: series.color,
      },
    })),
  };

  return <BaseChart data={data} options={options} />;
};

export default LineChart;
```

### Widget System Patterns

#### Widget Container Pattern (MUST FOLLOW)
```typescript
// Example: WidgetContainer.tsx
import React, { useState } from 'react';
import {
  Card,
  CardContent,
  CardActions,
  IconButton,
  Menu,
  MenuItem,
  Typography,
} from '@mui/material';
import { MoreVert, Edit, Delete, Refresh } from '@mui/icons-material';

interface IWidgetContainerProps {
  title: string;
  subtitle?: string;
  loading?: boolean;
  error?: string;
  children: React.ReactNode;
  onEdit?: () => void;
  onDelete?: () => void;
  onRefresh?: () => void;
  customActions?: React.ReactNode;
}

const WidgetContainer: React.FC<IWidgetContainerProps> = ({
  title,
  subtitle,
  loading,
  error,
  children,
  onEdit,
  onDelete,
  onRefresh,
  customActions,
}) => {
  const [anchorEl, setAnchorEl] = useState<null | HTMLElement>(null);

  const handleMenuOpen = (event: React.MouseEvent<HTMLElement>) => {
    setAnchorEl(event.currentTarget);
  };

  const handleMenuClose = () => {
    setAnchorEl(null);
  };

  return (
    <Card sx={{ height: '100%', display: 'flex', flexDirection: 'column' }}>
      <CardContent sx={{ flexGrow: 1 }}>
        <Box display="flex" justifyContent="space-between" alignItems="center">
          <Box>
            <Typography variant="h6" component="div">
              {title}
            </Typography>
            {subtitle && (
              <Typography variant="body2" color="text.secondary">
                {subtitle}
              </Typography>
            )}
          </Box>
          
          <Box>
            {customActions}
            <IconButton onClick={handleMenuOpen}>
              <MoreVert />
            </IconButton>
          </Box>
        </Box>

        <Menu
          anchorEl={anchorEl}
          open={Boolean(anchorEl)}
          onClose={handleMenuClose}
        >
          {onRefresh && (
            <MenuItem onClick={() => { onRefresh(); handleMenuClose(); }}>
              <Refresh sx={{ mr: 1 }} /> Refresh
            </MenuItem>
          )}
          {onEdit && (
            <MenuItem onClick={() => { onEdit(); handleMenuClose(); }}>
              <Edit sx={{ mr: 1 }} /> Edit
            </MenuItem>
          )}
          {onDelete && (
            <MenuItem onClick={() => { onDelete(); handleMenuClose(); }}>
              <Delete sx={{ mr: 1 }} /> Delete
            </MenuItem>
          )}
        </Menu>

        <Box mt={2} sx={{ height: 'calc(100% - 80px)' }}>
          {error ? (
            <Typography color="error">{error}</Typography>
          ) : (
            children
          )}
        </Box>
      </CardContent>
    </Card>
  );
};

export default WidgetContainer;
```

#### Dashboard Layout Pattern (MUST USE)
```typescript
// Example: DashboardLayout.tsx
import React from 'react';
import { Responsive, WidthProvider } from 'react-grid-layout';
import { Box } from '@mui/material';
import 'react-grid-layout/css/styles.css';
import 'react-resizable/css/styles.css';

const ResponsiveGridLayout = WidthProvider(Responsive);

interface IDashboardLayoutProps {
  widgets: Array<{
    id: string;
    component: React.ReactNode;
    layout: {
      x: number;
      y: number;
      w: number;
      h: number;
    };
  }>;
  editable?: boolean;
  onLayoutChange?: (layout: any) => void;
}

const DashboardLayout: React.FC<IDashboardLayoutProps> = ({
  widgets,
  editable = false,
  onLayoutChange,
}) => {
  const layouts = {
    lg: widgets.map(widget => ({
      i: widget.id,
      ...widget.layout,
    })),
  };

  return (
    <Box sx={{ width: '100%' }}>
      <ResponsiveGridLayout
        className="layout"
        layouts={layouts}
        breakpoints={{ lg: 1200, md: 996, sm: 768, xs: 480, xxs: 0 }}
        cols={{ lg: 12, md: 10, sm: 6, xs: 4, xxs: 2 }}
        isDraggable={editable}
        isResizable={editable}
        onLayoutChange={onLayoutChange}
        margin={[16, 16]}
        containerPadding={[16, 16]}
      >
        {widgets.map(widget => (
          <div key={widget.id}>
            {widget.component}
          </div>
        ))}
      </ResponsiveGridLayout>
    </Box>
  );
};

export default DashboardLayout;
```

## 🎯 FORM PATTERNS

### Form Component Pattern (MUST FOLLOW)
```typescript
// Example: StandardForm.tsx
import React from 'react';
import { useForm, Controller } from 'react-hook-form';
import {
  Box,
  TextField,
  Button,
  FormControl,
  FormHelperText,
} from '@mui/material';
import { yupResolver } from '@hookform/resolvers/yup';
import * as yup from 'yup';

interface IFormData {
  title: string;
  description?: string;
  category: string;
}

const schema = yup.object({
  title: yup.string().required('Title is required').max(255),
  description: yup.string().max(1000),
  category: yup.string().required('Category is required'),
});

interface IStandardFormProps {
  initialData?: Partial<IFormData>;
  onSubmit: (data: IFormData) => void;
  loading?: boolean;
}

const StandardForm: React.FC<IStandardFormProps> = ({
  initialData,
  onSubmit,
  loading = false,
}) => {
  const {
    control,
    handleSubmit,
    formState: { errors },
  } = useForm<IFormData>({
    resolver: yupResolver(schema),
    defaultValues: {
      title: '',
      description: '',
      category: '',
      ...initialData,
    },
  });

  return (
    <Box component="form" onSubmit={handleSubmit(onSubmit)}>
      <Controller
        name="title"
        control={control}
        render={({ field }) => (
          <TextField
            {...field}
            fullWidth
            label="Title"
            error={!!errors.title}
            helperText={errors.title?.message}
            margin="normal"
          />
        )}
      />

      <Controller
        name="description"
        control={control}
        render={({ field }) => (
          <TextField
            {...field}
            fullWidth
            label="Description"
            multiline
            rows={4}
            error={!!errors.description}
            helperText={errors.description?.message}
            margin="normal"
          />
        )}
      />

      <Controller
        name="category"
        control={control}
        render={({ field }) => (
          <TextField
            {...field}
            fullWidth
            select
            label="Category"
            error={!!errors.category}
            helperText={errors.category?.message}
            margin="normal"
          >
            {/* Options */}
          </TextField>
        )}
      />

      <Box mt={2}>
        <Button
          type="submit"
          variant="contained"
          disabled={loading}
          fullWidth
        >
          {loading ? 'Saving...' : 'Save'}
        </Button>
      </Box>
    </Box>
  );
};

export default StandardForm;
```

## 📱 RESPONSIVE DESIGN PATTERNS

### Responsive Component Pattern (MUST IMPLEMENT)
```typescript
// Example: ResponsiveComponent.tsx
import React from 'react';
import {
  Box,
  useTheme,
  useMediaQuery,
  Grid,
  Hidden,
} from '@mui/material';

interface IResponsiveComponentProps {
  children: React.ReactNode;
}

const ResponsiveComponent: React.FC<IResponsiveComponentProps> = ({
  children,
}) => {
  const theme = useTheme();
  const isMobile = useMediaQuery(theme.breakpoints.down('md'));
  const isTablet = useMediaQuery(theme.breakpoints.between('md', 'lg'));

  return (
    <Box
      sx={{
        padding: {
          xs: 1, // Mobile
          sm: 2, // Small tablet
          md: 3, // Large tablet
          lg: 4, // Desktop
        },
        margin: {
          xs: 0,
          md: 'auto',
        },
        maxWidth: {
          xs: '100%',
          lg: 1200,
        },
      }}
    >
      <Grid container spacing={{ xs: 1, sm: 2, md: 3 }}>
        <Grid item xs={12} md={8}>
          {/* Main content */}
          {children}
        </Grid>
        
        {/* Hide sidebar on mobile */}
        <Hidden mdDown>
          <Grid item md={4}>
            {/* Sidebar content */}
          </Grid>
        </Hidden>
      </Grid>
    </Box>
  );
};

export default ResponsiveComponent;
```

## 🎨 CHART DESIGN RULES

### Color Palette (MUST USE)
Based on [docs/user-manual/차트_유형별_사용_가이드.md](mdc:docs/user-manual/차트_유형별_사용_가이드.md):

```typescript
// Example: chartColors.ts
export const CHART_COLORS = {
  primary: [
    '#1f77b4', '#ff7f0e', '#2ca02c', '#d62728', '#9467bd',
    '#8c564b', '#e377c2', '#7f7f7f', '#bcbd22', '#17becf'
  ],
  accessible: [
    '#1f77b4', '#ff7f0e', '#2ca02c', '#d62728', '#9467bd'
  ],
  gradients: {
    blue: ['#1f77b4', '#87ceeb'],
    green: ['#2ca02c', '#98fb98'],
    red: ['#d62728', '#ffa0a0'],
  },
};

export const getChartColor = (index: number): string => {
  return CHART_COLORS.primary[index % CHART_COLORS.primary.length];
};

export const getAccessibleColor = (index: number): string => {
  return CHART_COLORS.accessible[index % CHART_COLORS.accessible.length];
};
```

