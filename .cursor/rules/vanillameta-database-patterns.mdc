## 🔒 DATABASE SECURITY PATTERNS

### Connection Security (MUST IMPLEMENT)
```typescript
// Example: secure connection handling
@Injectable()
export class SecureConnectionService {
  async validateConnection(connectionDto: ConnectionDto): Promise<boolean> {
    // Validate connection parameters
    if (!this.isValidHost(connectionDto.host)) {
      throw new BadRequestException('Invalid host format');
    }

    if (!this.isValidPort(connectionDto.port)) {
      throw new BadRequestException('Invalid port number');
    }

    // Test connection with timeout
    const connection = this.createTemporaryConnection(connectionDto);
    
    try {
      await Promise.race([
        connection.raw('SELECT 1'),
        this.timeout(5000), // 5 second timeout
      ]);
      
      return true;
    } catch (error) {
      this.logger.error('Connection validation failed', error);
      return false;
    } finally {
      await connection.destroy();
    }
  }

  private isValidHost(host: string): boolean {
    // Implement host validation logic
    const hostRegex = /^[a-zA-Z0-9.-]+$/;
    return hostRegex.test(host) && !host.includes('..');
  }

  private isValidPort(port: number): boolean {
    return port > 0 && port <= 65535;
  }
}
```

### Query Sanitization (MUST USE)
```typescript
// Example: input sanitization
@Injectable()
export class QuerySanitizer {
  sanitizeTableName(tableName: string): string {
    // Only allow alphanumeric and underscore
    if (!/^[a-zA-Z0-9_]+$/.test(tableName)) {
      throw new BadRequestException('Invalid table name');
    }
    return tableName;
  }

  sanitizeColumnName(columnName: string): string {
    // Only allow alphanumeric, underscore, and dot
    if (!/^[a-zA-Z0-9_.]+$/.test(columnName)) {
      throw new BadRequestException('Invalid column name');
    }
    return columnName;
  }

  buildDynamicQuery(
    connection: any,
    tableName: string,
    columns: string[],
    filters: Record<string, any>,
  ) {
    const safeTableName = this.sanitizeTableName(tableName);
    const safeColumns = columns.map(col => this.sanitizeColumnName(col));
    
    let query = connection(safeTableName).select(safeColumns);
    
    // Safe filter application
    Object.entries(filters).forEach(([key, value]) => {
      const safeKey = this.sanitizeColumnName(key);
      query = query.where(safeKey, '=', value);
    });
    
    return query;
  }
}
```

## 🔄 TRANSACTION PATTERNS

### Transaction Management (MUST USE)
```typescript
// Example: transaction handling
@Injectable()
export class TransactionService {
  async executeInTransaction<T>(
    connection: any,
    operation: (trx: any) => Promise<T>,
  ): Promise<T> {
    const trx = await connection.transaction();
    
    try {
      const result = await operation(trx);
      await trx.commit();
      return result;
    } catch (error) {
      await trx.rollback();
      this.logger.error('Transaction rolled back', error);
      throw error;
    }
  }

  async createDashboardWithWidgets(
    connection: any,
    dashboardData: CreateDashboardDto,
    widgets: CreateWidgetDto[],
  ): Promise<Dashboard> {
    return this.executeInTransaction(connection, async (trx) => {
      // Create dashboard
      const [dashboardId] = await trx('dashboards')
        .insert(dashboardData)
        .returning('id');

      // Create widgets
      const widgetPromises = widgets.map(widget =>
        trx('widgets').insert({
          ...widget,
          dashboard_id: dashboardId,
        })
      );

      await Promise.all(widgetPromises);

      // Return complete dashboard
      return trx('dashboards')
        .where('id', dashboardId)
        .first();
    });
  }
}
```

## 🚫 CRITICAL PROHIBITIONS

### NEVER DO These Database Operations
```typescript
// ❌ NEVER: Raw string concatenation
// const query = `SELECT * FROM ${tableName} WHERE id = ${userId}`;

// ❌ NEVER: Unvalidated dynamic queries
// const columns = userInput.split(',');
// connection.select(columns).from(tableName);

// ❌ NEVER: Long-running transactions without timeout
// const trx = await connection.transaction();
// // ... long operations without timeout

// ❌ NEVER: Storing sensitive data in plain text
// await connection('users').insert({
//   password: plainTextPassword,
//   api_key: plainTextApiKey,
// });

// ❌ NEVER: Ignoring connection limits
// for (let i = 0; i < 1000; i++) {
//   const connection = knex(config); // Creates too many connections
// }
```

### ALWAYS DO These Database Operations
```typescript
// ✅ ALWAYS: Use parameterized queries
const query = connection('table').where('id', '=', userId);

// ✅ ALWAYS: Validate input before queries
const safeTableName = this.validateTableName(tableName);

// ✅ ALWAYS: Use transactions for multi-step operations
await this.executeInTransaction(connection, async (trx) => {
  // Multi-step operations
});

// ✅ ALWAYS: Hash sensitive data
await connection('users').insert({
  password: await bcrypt.hash(password, 10),
  api_key: this.generateSecureApiKey(),
});

// ✅ ALWAYS: Reuse connections with proper pooling
const connection = this.connectionService.getConnection(connectionId);
```

