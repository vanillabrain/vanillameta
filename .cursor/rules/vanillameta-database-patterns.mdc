#### Query Optimization (MUST IMPLEMENT)
```typescript
// Example: optimized query patterns
@Injectable()
export class OptimizedQueryService {
  async getDataWithPagination(
    connection: any,
    query: PaginatedQueryDto,
  ): Promise<PaginatedResult> {
    const countQuery = connection('table').count('* as total');
    const dataQuery = connection('table')
      .select('*')
      .limit(query.limit)
      .offset((query.page - 1) * query.limit)
      .orderBy('created_at', 'desc');

    const [countResult, data] = await Promise.all([
      countQuery,
      dataQuery,
    ]);

    return {
      data,
      total: countResult[0].total,
      page: query.page,
      limit: query.limit,
    };
  }

  async executeWithRetry(
    connection: any,
    queryFn: () => Promise<any>,
    maxRetries: number = 3,
  ): Promise<any> {
    for (let attempt = 1; attempt <= maxRetries; attempt++) {
      try {
        return await queryFn();
      } catch (error) {
        if (attempt === maxRetries) {
          throw error;
        }
        
        this.logger.warn(`Query attempt ${attempt} failed, retrying...`);
        await this.delay(1000 * attempt); // Exponential backoff
      }
    }
  }
}
```

## 🔍 QUERY PATTERNS

### Safe Query Building (MUST USE)
```typescript
// Example: parameterized queries
@Injectable()
export class SafeQueryService {
  async buildSafeQuery(
    connection: any,
    filters: QueryFilters,
  ): Promise<any> {
    let query = connection('table').select('*');

    // Safe parameter binding
    if (filters.status) {
      query = query.where('status', '=', filters.status);
    }

    if (filters.dateRange) {
      query = query.whereBetween('created_at', [
        filters.dateRange.start,
        filters.dateRange.end,
      ]);
    }

    if (filters.search) {
      query = query.where(function() {
        this.where('title', 'like', `%${filters.search}%`)
            .orWhere('description', 'like', `%${filters.search}%`);
      });
    }

    return query;
  }

  // NEVER DO: String concatenation for queries
  // async unsafeQuery(connection: any, userInput: string) {
  //   return connection.raw(`SELECT * FROM table WHERE name = '${userInput}'`);
  // }
}
```

### Complex Join Patterns (SHOULD USE)
```typescript
// Example: optimized joins
async getComplexData(connection: any, filters: ComplexFilters) {
  return connection('main_table as m')
    .select([
      'm.id',
      'm.title',
      'u.name as user_name',
      'c.name as category_name',
    ])
    .leftJoin('users as u', 'm.user_id', 'u.id')
    .leftJoin('categories as c', 'm.category_id', 'c.id')
    .where('m.status', 'active')
    .whereIn('m.category_id', filters.categoryIds)
    .orderBy('m.created_at', 'desc')
    .limit(filters.limit);
}
```

## 📊 ANALYTICS QUERY PATTERNS

### Time-Series Data (MUST OPTIMIZE)
```typescript
// Example: time-series aggregation
async getTimeSeriesData(
  connection: any,
  timeRange: TimeRangeDto,
): Promise<TimeSeriesResult[]> {
  const timeFormat = this.getTimeFormat(timeRange.granularity);
  
  return connection('analytics_events')
    .select([
      connection.raw(`DATE_FORMAT(created_at, '${timeFormat}') as time_bucket`),
      connection.raw('COUNT(*) as count'),
      connection.raw('SUM(value) as total_value'),
      connection.raw('AVG(value) as avg_value'),
    ])
    .whereBetween('created_at', [timeRange.start, timeRange.end])
    .groupBy('time_bucket')
    .orderBy('time_bucket');
}

private getTimeFormat(granularity: string): string {
  switch (granularity) {
    case 'hour': return '%Y-%m-%d %H:00:00';
    case 'day': return '%Y-%m-%d';
    case 'month': return '%Y-%m';
    case 'year': return '%Y';
    default: return '%Y-%m-%d';
  }
}
```

### Dashboard Aggregations (MUST CACHE)
```typescript
// Example: cached dashboard queries
@Injectable()
export class DashboardQueryService {
  @Cacheable('dashboard-metrics', 300) // 5 minutes cache
  async getDashboardMetrics(
    connection: any,
    dashboardId: string,
  ): Promise<DashboardMetrics> {
    const queries = {
      totalUsers: connection('users').count('* as count'),
      activeUsers: connection('users')
        .where('last_active', '>', new Date(Date.now() - 24 * 60 * 60 * 1000))
        .count('* as count'),
      totalRevenue: connection('orders')
        .sum('amount as total')
        .where('status', 'completed'),
      recentOrders: connection('orders')
        .select('*')
        .orderBy('created_at', 'desc')
        .limit(10),
    };

    const results = await Promise.all(Object.values(queries));
    
    return {
      totalUsers: results[0][0].count,
      activeUsers: results[1][0].count,
      totalRevenue: results[2][0].total || 0,
      recentOrders: results[3],
    };
  }
}
